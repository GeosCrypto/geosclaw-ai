# GeosclawAI Environment Configuration
# Copy this file to .env and fill in your values

# ─── AI Provider Keys ───────────────────────────────────────────────────────
# Anthropic (Claude) – https://console.anthropic.com/
GEOSCLAW_ANTHROPIC_API_KEY=

# OpenAI (GPT-4o) – https://platform.openai.com/api-keys
GEOSCLAW_OPENAI_API_KEY=

# Google Gemini – https://aistudio.google.com/apikey
GEOSCLAW_GEMINI_API_KEY=

# Azure OpenAI – https://portal.azure.com/
GEOSCLAW_AZURE_OPENAI_API_KEY=
GEOSCLAW_AZURE_OPENAI_ENDPOINT=
GEOSCLAW_AZURE_OPENAI_DEPLOYMENT=gpt-4o
GEOSCLAW_AZURE_OPENAI_API_VERSION=2024-08-01-preview

# ─── Provider Selection ──────────────────────────────────────────────────────
# Which provider to use by default:
#   anthropic | openai | gemini | ollama | azure_openai
GEOSCLAW_DEFAULT_PROVIDER=anthropic

# ─── Model Selection ─────────────────────────────────────────────────────────
GEOSCLAW_ANTHROPIC_MODEL=claude-opus-4-5
GEOSCLAW_OPENAI_MODEL=gpt-4o
GEOSCLAW_GEMINI_MODEL=gemini-2.0-flash
GEOSCLAW_OLLAMA_MODEL=llama3.2
GEOSCLAW_OLLAMA_BASE_URL=http://localhost:11434/v1

# ─── Agent Behaviour ─────────────────────────────────────────────────────────
GEOSCLAW_MAX_ITERATIONS=50
GEOSCLAW_MAX_TOKENS=8192
GEOSCLAW_TEMPERATURE=0.7
GEOSCLAW_STREAMING=true

# ─── Token Budget (Phase 2) ──────────────────────────────────────────────────
# Set to 0 to disable budget limits
GEOSCLAW_TOKEN_BUDGET=0
GEOSCLAW_TOKEN_BUDGET_WARNING_THRESHOLD=0.85

# ─── Retry / Reliability (Phase 2) ───────────────────────────────────────────
GEOSCLAW_MAX_PROVIDER_RETRIES=3
GEOSCLAW_RETRY_BASE_DELAY=1.0

# ─── Parallel Tool Calls (Phase 2) ───────────────────────────────────────────
GEOSCLAW_PARALLEL_TOOL_CALLS=true

# ─── Workspace ───────────────────────────────────────────────────────────────
# Directory the agent operates in (file reads/writes are relative to this)
GEOSCLAW_WORKSPACE_DIR=.
GEOSCLAW_MAX_FILE_SIZE_KB=512

# ─── Shell Execution ─────────────────────────────────────────────────────────
GEOSCLAW_ALLOW_SHELL=true
GEOSCLAW_SHELL_TIMEOUT=30

# ─── Web Search ──────────────────────────────────────────────────────────────
GEOSCLAW_ENABLE_WEB_SEARCH=true
GEOSCLAW_MAX_SEARCH_RESULTS=5

# ─── Memory ──────────────────────────────────────────────────────────────────
GEOSCLAW_MAX_HISTORY_MESSAGES=100
GEOSCLAW_MEMORY_FILE=.geosclaw_memory.json

# ─── API Server ──────────────────────────────────────────────────────────────
GEOSCLAW_API_HOST=0.0.0.0
GEOSCLAW_API_PORT=8000
# Optional: protect the API with a key
GEOSCLAW_API_KEY=
